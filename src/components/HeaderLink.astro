---
export interface Props extends astroHTML.JSX.AnchorHTMLAttributes {}

const { href, class: className, ...props } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "");
const isHome = href === "/" && path === "";
const isOtherPage = typeof href === "string" && href.startsWith("/") && href.length > 1
  ? path.substring(1).startsWith(href.substring(1))
  : false;
const isActive = isHome || isOtherPage;
---

<a
  href={href}
  class:list={[className, { active: isActive }, "unset inkrain-link"]}
  aria-current={isActive ? "page" : undefined}
  {...props}
><slot /></a>

<style>
  .inkrain-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 9px 8px;
    color: var(--ink-muted);
    font-family: var(--font-sans);
    font-size: 12px;
    letter-spacing: 0;
    text-decoration: none;
    background-image: none !important;
  }

  .inkrain-link::after {
    content: "";
    position: absolute;
    right: 8px;
    bottom: 3px;
    left: 8px;
    height: 1px;
    background: var(--stamp);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 160ms ease;
  }

  .inkrain-link:hover,
  .inkrain-link.active {
    color: var(--ink);
  }

  .inkrain-link:hover::after,
  .inkrain-link.active::after {
    transform: scaleX(1);
  }

  @media (max-width: 980px) {
    .inkrain-link {
      display: flex;
      width: 100%;
      padding: 14px 0;
      color: var(--ink);
      font-family: var(--font-serif);
      font-size: 17px;
    }

    .inkrain-link::after {
      display: none;
    }
  }
</style>
