---
import 'src/styles/telegramItem.css';
import 'src/styles/comments.css';
import 'prismjs/themes/prism.css';
import dayjs from 'src/lib/dayjs';
import { getEnv } from 'src/lib/env';
import { platformLabels } from 'src/lib/moments/types';
import { presentMoment } from 'src/lib/moments/presentation';
import PlatformLogo from './PlatformLogo.astro';

const locale = getEnv('LOCALE', Astro);
const timezone = getEnv('TIMEZONE', Astro);
locale && dayjs.locale(locale);
const { post, compact = false, detailed = false } = Astro.props;
const datetime = dayjs(post.datetime).tz(timezone);
const exactDate = datetime.format('YYYY年M月D日 HH:mm');
const { body, lightboxes, previewGallery } = presentMoment(post.content, post.id);
const longNote = !detailed && post.text.length > 650;
const platform = post.platform === 'x' ? 'X' : platformLabels[post.platform] || post.platform;
---

<article class:list={['telegram-item', compact && 'telegram-item-compact', detailed && 'telegram-item-detailed']} style={{'view-transition-name': `post-${post.id}`}}>
  <div class="time-wrapper">
    <a class="unset telegram-permalink" href={`/moments/posts/${post.id}`} aria-label={`阅读 ${exactDate} 的碎碎念`}>
      <time datetime={post.datetime} title={exactDate}>
        <span class="moment-date">{datetime.format('MM.DD')}</span>
        <span class="moment-year">{datetime.format('YYYY')}<span aria-hidden="true"> · </span>{datetime.format('HH:mm')}</span>
      </time>
    </a>
  </div>
  <div class="moment-main">
    <header class="moment-context">
      <span class="moment-platform" data-platform={post.platform} role="img" aria-label={platform} title={platform}><PlatformLogo platform={post.platform} /></span>
      {post.sourceUrl && <a class="unset moment-source" href={post.sourceUrl} target="_blank" rel="noopener noreferrer" aria-label={`在 ${platform} 查看原文`}>原文</a>}
    </header>
    {longNote ? (
      <div class="moment-long-note">
        <div class="moment-preview"><p class="moment-excerpt">{post.text.slice(0, 260).trim()}…</p>{previewGallery && <div class="telegram-content" set:html={previewGallery} />}</div>
        <details class="moment-expand">
          <summary><span class="moment-expand-open">展开全文</span><span class="moment-expand-close">收起全文</span><span aria-hidden="true"> ↕</span></summary>
          <div class="text-box telegram-content" set:html={body} />
        </details>
      </div>
    ) : <div class="text-box telegram-content" set:html={body} />}
    <div class="moment-lightboxes" set:html={lightboxes} />
    {!detailed && <a class="unset moment-comment-link" href={`/moments/posts/${post.id}#comments`}>留言 →</a>}
  </div>
</article>

<script>
  document.addEventListener('beforetoggle', event => {
    const target = event.target;
    if (!(target instanceof HTMLElement) || !target.matches('.moment-lightbox') || (event as ToggleEvent).newState !== 'open') return;
    const image = target.querySelector<HTMLImageElement>('img[data-full-src]');
    if (image && !image.getAttribute('src')) {
      if (image.dataset.fullFallback) image.addEventListener('error', () => { image.src = image.dataset.fullFallback!; }, { once: true });
      image.src = image.dataset.fullSrc!;
    }
  }, true);
</script>
