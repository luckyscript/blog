---
import "src/styles/telegramItem.css";
import "prismjs/themes/prism.css";
import dayjs from "src/lib/dayjs";
import { getEnv } from "src/lib/env";

const locale = getEnv(import.meta.env, Astro, "LOCALE");
const timezone = getEnv(import.meta.env, Astro, "TIMEZONE");
locale && dayjs.locale(locale);

const { post, compact = false } = Astro.props;
const datetime = dayjs(post.datetime).tz(timezone);
const timeago = datetime.isBefore(dayjs().subtract(1, "w"))
  ? datetime.format("HH:mm · ll")
  : datetime.fromNow();
---

<article
  class:list={["telegram-item", compact && "telegram-item-compact"]}
  style={{ "view-transition-name": `post-${post.id}` }}
>
  <div class="time-wrapper">
    <a class="unset telegram-permalink" href={`/moments/posts/${post.id}`} aria-label={`打开碎碎念 ${post.id}`}>
      <time datetime={post.datetime} title={timeago}>{timeago}</time>
    </a>
  </div>
  {post.content.length > 0 && <div class="text-box telegram-content" set:html={post.content} />}
</article>

<style>
  .telegram-item {
    position: relative;
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: 28px;
    padding: 30px 0 36px;
    border-bottom: 1px solid var(--border-soft);
  }

  .telegram-item::before {
    content: "";
    position: absolute;
    top: 35px;
    left: 98px;
    width: 4px;
    height: 4px;
    background: var(--stamp);
  }

  .telegram-item:last-child {
    border-bottom: 0;
  }

  .time-wrapper {
    padding-top: 1px;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.04em;
  }

  .telegram-permalink {
    color: inherit;
    background-image: none !important;
  }

  .telegram-permalink:hover {
    color: var(--stamp);
  }

  .telegram-item-compact {
    grid-template-columns: 90px minmax(0, 1fr);
    gap: 22px;
    padding-block: 22px 26px;
  }

  .telegram-item-compact::before {
    top: 27px;
    left: 78px;
  }

  @media (max-width: 680px) {
    .telegram-item,
    .telegram-item-compact {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
      padding-block: 24px 30px;
    }

    .telegram-item::before,
    .telegram-item-compact::before {
      top: 29px;
      left: -8px;
    }
  }
</style>
