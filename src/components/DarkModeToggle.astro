<theme-cycle class="theme-cycle">
  <button
    class="theme-cycle-button"
    type="button"
    data-current-theme="paper"
    data-label="宣纸 · 点击切换月白"
    aria-label="当前宣纸主题，点击切换到月白主题"
  >
    <span class="theme-icon is-active" data-icon-theme="paper" aria-hidden="true">
      <span class="theme-glyph theme-glyph-paper"></span>
    </span>
    <span class="theme-icon" data-icon-theme="moon" aria-hidden="true">
      <span class="theme-glyph theme-glyph-moon"></span>
    </span>
    <span class="theme-icon" data-icon-theme="ink" aria-hidden="true">
      <span class="theme-glyph theme-glyph-ink"></span>
    </span>
    <span class="sr-only theme-status">当前宣纸主题</span>
  </button>
</theme-cycle>

<script>
  type InkRainTheme = "paper" | "moon" | "ink";

  const themeOrder: InkRainTheme[] = ["paper", "moon", "ink"];
  const themeNames: Record<InkRainTheme, string> = {
    paper: "宣纸",
    moon: "月白",
    ink: "玄墨",
  };
  const themeColors: Record<InkRainTheme, string> = {
    paper: "#f4f0e6",
    moon: "#edf4f3",
    ink: "#20272b",
  };

  function sendGiscusTheme(theme: InkRainTheme) {
    const iframe = document.querySelector("iframe.giscus-frame") as HTMLIFrameElement | null;
    iframe?.contentWindow?.postMessage(
      { giscus: { setConfig: { theme: theme === "ink" ? "dark" : "light" } } },
      "https://giscus.app"
    );
  }

  function applyTheme(theme: InkRainTheme) {
    const root = document.documentElement;
    root.dataset.theme = theme;
    root.classList.toggle("dark", theme === "ink");

    document.head
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute("content", themeColors[theme]);

    localStorage.setItem("inkrain-theme", theme);
    localStorage.removeItem("theme");
    sendGiscusTheme(theme);
  }

  class ThemeCycle extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector<HTMLButtonElement>("button");
      const status = this.querySelector<HTMLElement>(".theme-status");
      const icons = Array.from(this.querySelectorAll<HTMLElement>("[data-icon-theme]"));
      if (!button) return;

      const sync = () => {
        const current = (document.documentElement.dataset.theme || "paper") as InkRainTheme;
        const currentIndex = themeOrder.indexOf(current);
        const next = themeOrder[(currentIndex + 1) % themeOrder.length];

        button.dataset.currentTheme = current;
        button.dataset.label = `${themeNames[current]} · 点击切换${themeNames[next]}`;
        button.setAttribute(
          "aria-label",
          `当前${themeNames[current]}主题，点击切换到${themeNames[next]}主题`
        );
        if (status) status.textContent = `当前${themeNames[current]}主题`;

        icons.forEach((icon) => {
          icon.classList.toggle("is-active", icon.dataset.iconTheme === current);
        });
      };

      button.addEventListener("click", () => {
        const current = (document.documentElement.dataset.theme || "paper") as InkRainTheme;
        const currentIndex = themeOrder.indexOf(current);
        const next = themeOrder[(currentIndex + 1) % themeOrder.length];
        applyTheme(next);
        sync();
      });

      sync();
    }
  }

  if (!customElements.get("theme-cycle")) {
    customElements.define("theme-cycle", ThemeCycle);
  }
</script>

<style>
  .theme-cycle {
    display: inline-flex;
  }

  .theme-cycle-button {
    position: relative;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    color: var(--ink);
    background: transparent;
    cursor: pointer;
  }

  .theme-cycle-button::before {
    content: "";
    position: absolute;
    inset: 4px;
    border: 1px solid color-mix(in srgb, var(--stamp) 66%, var(--border));
    transform: rotate(-3deg);
    opacity: 0.72;
    transition: transform 160ms ease, opacity 160ms ease, border-color 160ms ease;
  }

  .theme-cycle-button::after {
    content: attr(data-label);
    position: absolute;
    top: calc(100% + 7px);
    left: 50%;
    z-index: 60;
    width: max-content;
    padding: 3px 7px;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--border);
    font-family: var(--font-serif);
    font-size: 11px;
    line-height: 1.4;
    transform: translate(-50%, -3px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: transform 140ms ease, opacity 140ms ease, visibility 140ms ease;
  }

  .theme-cycle-button:hover::before,
  .theme-cycle-button:focus-visible::before {
    border-color: var(--stamp);
    transform: rotate(0deg);
    opacity: 1;
  }

  .theme-cycle-button:hover::after,
  .theme-cycle-button:focus-visible::after {
    transform: translate(-50%, 0);
    opacity: 1;
    visibility: visible;
  }

  .theme-icon {
    position: relative;
    z-index: 1;
    display: none;
    place-items: center;
    width: 24px;
    height: 24px;
    font-size: 13px;
    line-height: 1;
  }

  .theme-icon.is-active {
    display: grid;
  }

  .theme-glyph {
    position: relative;
    display: block;
    color: currentColor;
  }

  .theme-glyph-paper {
    width: 13px;
    height: 16px;
    border: 1.5px solid currentColor;
    box-sizing: border-box;
    transform: rotate(-2deg);
  }

  .theme-glyph-paper::before {
    content: "";
    position: absolute;
    top: 4px;
    right: 2px;
    left: 3px;
    height: 1px;
    background: currentColor;
    box-shadow: 0 4px 0 currentColor;
    opacity: 0.72;
  }

  .theme-glyph-moon {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    box-shadow: 4px 1px 0 0 currentColor;
    transform: translate(-2px, -1px) rotate(-12deg);
  }

  .theme-glyph-ink {
    width: 11px;
    height: 14px;
    border-radius: 9px 9px 9px 2px;
    background: currentColor;
    transform: rotate(45deg) translate(-1px, 1px);
  }

  .theme-cycle-button[data-current-theme="paper"] .theme-icon {
    color: var(--stamp);
  }

  .theme-cycle-button[data-current-theme="moon"] .theme-icon {
    color: var(--accent);
  }

  .theme-cycle-button[data-current-theme="ink"] .theme-icon {
    color: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-cycle-button::before,
    .theme-cycle-button::after {
      transition: none;
    }
  }
</style>
