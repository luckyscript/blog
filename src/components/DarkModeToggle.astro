---
import { themeOrder, themes } from "../lib/themes";
import ThemeGlyph from "./ThemeGlyph.astro";
---

<theme-cycle class="theme-cycle">
  <button
    class="theme-cycle-button"
    type="button"
    data-current-theme="paper"
    data-label="选择主题 · 当前宣纸"
    aria-label="选择主题，当前宣纸"
    aria-haspopup="dialog"
    aria-controls="theme-picker-panel"
    aria-expanded="false"
  >
    {themeOrder.map((id) => (
      <span class:list={["theme-icon", id === "paper" && "is-active"]} data-icon-theme={id} aria-hidden="true">
        <ThemeGlyph theme={id} />
      </span>
    ))}
    <span class="sr-only theme-status" role="status">当前宣纸主题</span>
  </button>
  <section id="theme-picker-panel" class="theme-picker-panel" role="dialog" aria-labelledby="theme-picker-title" hidden>
    <div class="theme-picker-heading">
      <div>
        <h2 id="theme-picker-title">选择主题</h2>
        <p>八种纸色，一处心境</p>
      </div>
      <button class="theme-picker-close" type="button" aria-label="关闭主题选择">×</button>
    </div>
    <div class="theme-picker-grid" role="group" aria-label="主题配色">
      {themeOrder.map((id) => (
        <button class="theme-choice" type="button" data-theme-option={id} aria-pressed={id === "paper" ? "true" : "false"}>
          <span class="theme-choice-preview theme-inkrain" data-theme={id} aria-hidden="true">
            <span class="theme-choice-icon"><ThemeGlyph theme={id} /></span>
            <span class="theme-choice-sample">听雨写字</span>
          </span>
          <span class="theme-choice-label">
            <span>{themes[id].name}</span>
            <span class="theme-choice-check" aria-hidden="true">✓</span>
          </span>
        </button>
      ))}
    </div>
  </section>
</theme-cycle>

<script>
  import { revealTheme } from "../lib/theme-transition";
  import { themeOrder, themes, type InkRainTheme } from "../lib/themes";

  function applyTheme(theme: InkRainTheme) {
    const root = document.documentElement;
    root.dataset.theme = theme;
    root.classList.toggle("dark", themes[theme].dark);

    document.head
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute("content", themes[theme].color);

    try {
      localStorage.setItem("inkrain-theme", theme);
      localStorage.removeItem("theme");
    } catch {
      // The current page can still change theme when storage is unavailable.
    }
  }

  class ThemeCycle extends HTMLElement {
    private dispose?: () => void;

    connectedCallback() {
      this.dispose?.();
      const button = this.querySelector<HTMLButtonElement>(".theme-cycle-button");
      const panel = this.querySelector<HTMLElement>(".theme-picker-panel");
      const closeButton = this.querySelector<HTMLButtonElement>(".theme-picker-close");
      const status = this.querySelector<HTMLElement>(".theme-status");
      const icons = Array.from(this.querySelectorAll<HTMLElement>("[data-icon-theme]"));
      const choices = Array.from(this.querySelectorAll<HTMLButtonElement>("[data-theme-option]"));
      if (!button || !panel || !closeButton) return;
      const events = new AbortController();
      const listen = { signal: events.signal };
      const currentTheme = () => {
        const value = document.documentElement.dataset.theme as InkRainTheme;
        return themeOrder.includes(value) ? value : "paper";
      };

      const sync = () => {
        const current = currentTheme();
        button.dataset.currentTheme = current;
        button.dataset.label = `选择主题 · 当前${themes[current].name}`;
        button.setAttribute("aria-label", `选择主题，当前${themes[current].name}`);
        if (status) status.textContent = `当前${themes[current].name}主题`;
        icons.forEach((icon) => {
          icon.classList.toggle("is-active", icon.dataset.iconTheme === current);
        });
        choices.forEach((choice) => {
          choice.setAttribute("aria-pressed", String(choice.dataset.themeOption === current));
        });
      };

      let desiredTheme = currentTheme();
      let switching = false;
      let activeReveal: ReturnType<typeof revealTheme> | undefined;
      let disconnected = false;
      let panelRequest = 0;

      const focusChoice = (choice: HTMLButtonElement | undefined) => {
        if (!choice) return;
        choice.focus({ preventScroll: true });
        // Scroll the panel, rather than the article, when the viewport is short.
        const item = choice.getBoundingClientRect();
        const bounds = panel.getBoundingClientRect();
        if (item.top < bounds.top + 8) panel.scrollTop -= bounds.top + 8 - item.top;
        else if (item.bottom > bounds.bottom - 8) panel.scrollTop += item.bottom - bounds.bottom + 8;
      };

      const positionPanel = () => {
        if (panel.hidden) return;
        panel.style.setProperty("--theme-panel-offset", "0px");
        const rect = panel.getBoundingClientRect();
        const leftOverflow = Math.max(0, 16 - rect.left);
        const rightOverflow = Math.max(0, rect.right - document.documentElement.clientWidth + 16);
        panel.style.setProperty("--theme-panel-offset", `${leftOverflow - rightOverflow}px`);
      };
      const closePanel = (restoreFocus = false) => {
        panelRequest++;
        panel.hidden = true;
        button.setAttribute("aria-expanded", "false");
        if (restoreFocus) button.focus({ preventScroll: true });
      };
      const togglePanel = async () => {
        const request = ++panelRequest;
        if (switching) {
          activeReveal?.skip();
          await activeReveal?.finished;
        }
        if (disconnected || request !== panelRequest) return;
        if (!panel.hidden) {
          closePanel(true);
          return;
        }
        panel.hidden = false;
        button.setAttribute("aria-expanded", "true");
        positionPanel();
        focusChoice(choices.find((choice) => choice.dataset.themeOption === currentTheme()));
      };

      const selectTheme = async (theme: InkRainTheme) => {
        // Close before the old snapshot so the panel never becomes part of the wash.
        closePanel(true);
        desiredTheme = theme;
        if (switching) {
          activeReveal?.skip();
          return;
        }

        switching = true;
        try {
          // A newer choice takes over an unfinished transition.
          while (!disconnected && currentTheme() !== desiredTheme) {
            const next = desiredTheme;
            activeReveal = revealTheme(button, themes[next].name, () => {
              applyTheme(next);
              sync();
            });
            await activeReveal.finished;
          }
        } finally {
          activeReveal = undefined;
          switching = false;
        }
      };

      // View Transition snapshots suppress hit testing on captured elements.
      // Keep the button's original hit area responsive while its image animates.
      const isTransitionButtonHit = (event: MouseEvent) => {
        if (!switching || button.contains(event.target as Node)) return false;
        const rect = button.getBoundingClientRect();
        return event.clientX >= rect.left && event.clientX <= rect.right
          && event.clientY >= rect.top && event.clientY <= rect.bottom;
      };
      const onTransitionMouseDown = (event: MouseEvent) => {
        if (isTransitionButtonHit(event)) event.preventDefault();
      };
      const onTransitionClick = (event: MouseEvent) => {
        if (!isTransitionButtonHit(event)) return;
        event.preventDefault();
        void togglePanel();
      };

      button.addEventListener("click", () => void togglePanel(), listen);
      button.addEventListener("keydown", (event) => {
        if (event.key === "ArrowDown" || event.key === "ArrowUp") {
          event.preventDefault();
          if (panel.hidden) void togglePanel();
        }
      }, listen);
      closeButton.addEventListener("click", () => closePanel(true), listen);
      choices.forEach((choice) => {
        choice.addEventListener("click", () => {
          const theme = choice.dataset.themeOption as InkRainTheme;
          if (themeOrder.includes(theme)) void selectTheme(theme);
        }, listen);
      });
      panel.addEventListener("keydown", (event) => {
        const index = choices.indexOf(document.activeElement as HTMLButtonElement);
        const steps: Record<string, number> = { ArrowRight: 1, ArrowLeft: -1, ArrowDown: 2, ArrowUp: -2 };
        let target: number | undefined;
        if (index >= 0 && event.key in steps) target = (index + steps[event.key] + choices.length) % choices.length;
        if (event.key === "Home") target = 0;
        if (event.key === "End") target = choices.length - 1;
        if (target !== undefined) {
          event.preventDefault();
          focusChoice(choices[target]);
        }
      }, listen);
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !panel.hidden) {
          event.preventDefault();
          closePanel(true);
        }
      }, listen);
      document.addEventListener("pointerdown", (event) => {
        if (!this.contains(event.target as Node)) closePanel();
      }, listen);
      document.addEventListener("focusin", (event) => {
        if (!this.contains(event.target as Node)) closePanel();
      }, listen);
      window.addEventListener("resize", positionPanel, listen);
      document.addEventListener("mousedown", onTransitionMouseDown, { ...listen, capture: true });
      document.addEventListener("click", onTransitionClick, { ...listen, capture: true });
      this.dispose = () => {
        disconnected = true;
        events.abort();
        closePanel();
        activeReveal?.skip();
      };

      sync();
    }

    disconnectedCallback() {
      this.dispose?.();
      this.dispose = undefined;
    }
  }

  if (!customElements.get("theme-cycle")) {
    customElements.define("theme-cycle", ThemeCycle);
  }
</script>

<style>
  .theme-cycle {
    position: relative;
    display: inline-flex;
  }

  .theme-cycle-button {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    color: var(--ink);
    background: transparent;
    cursor: pointer;
  }

  .theme-cycle-button::before {
    content: "";
    position: absolute;
    inset: 8px;
    border: 1px solid color-mix(in srgb, var(--stamp) 66%, var(--border));
    transform: rotate(-3deg);
    opacity: 0.72;
    transition: transform 160ms ease, opacity 160ms ease, border-color 160ms ease;
  }

  .theme-cycle-button::after {
    content: attr(data-label);
    position: absolute;
    top: calc(100% + 7px);
    right: 0;
    z-index: 60;
    width: max-content;
    max-width: calc(100vw - 24px);
    padding: 3px 7px;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--border);
    font-family: var(--font-serif);
    font-size: 11px;
    line-height: 1.4;
    transform: translateY(-3px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: transform 140ms ease, opacity 140ms ease, visibility 140ms ease;
  }

  .theme-cycle-button:hover::before,
  .theme-cycle-button:focus-visible::before {
    border-color: var(--stamp);
    transform: rotate(0deg);
    opacity: 1;
  }

  .theme-cycle-button:hover::after,
  .theme-cycle-button:focus-visible::after {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
  }

  .theme-cycle-button[aria-expanded="true"]::after {
    display: none;
  }

  .theme-picker-panel {
    position: absolute;
    top: calc(100% + 14px);
    right: 0;
    z-index: 60;
    box-sizing: border-box;
    width: min(340px, calc(100vw - 32px));
    max-height: calc(100dvh - 100px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 16px;
    color: var(--ink);
    background: var(--paper-bright);
    border: 1px solid var(--border);
    border-top: 2px solid var(--stamp);
    border-radius: 3px;
    box-shadow: 0 18px 48px color-mix(in srgb, var(--ink) 16%, transparent);
    transform: translateX(var(--theme-panel-offset, 0px));
    animation: theme-panel-in 150ms ease-out;
  }

  .theme-picker-panel[hidden] { display: none; }

  .theme-picker-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 14px;
  }

  .theme-picker-heading h2 {
    margin: 0;
    font-family: var(--font-kai);
    font-size: 21px;
    font-weight: 400;
    line-height: 1.3;
  }

  .theme-picker-heading p {
    margin: 4px 0 0;
    color: var(--ink-soft);
    font-family: var(--font-serif);
    font-size: 11px;
    line-height: 1.6;
  }

  .theme-picker-close {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    padding: 0;
    color: var(--ink-soft);
    background: transparent;
    border: 0;
    font-family: var(--font-sans);
    font-size: 23px;
    cursor: pointer;
  }

  .theme-picker-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .theme-choice {
    min-width: 0;
    padding: 6px;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--border-soft);
    border-radius: 2px;
    text-align: left;
    cursor: pointer;
    transition: border-color 140ms ease, background-color 140ms ease;
  }

  .theme-choice:hover,
  .theme-choice[aria-pressed="true"] {
    border-color: var(--stamp);
    background: color-mix(in srgb, var(--stamp) 5%, var(--paper-bright));
  }

  .theme-choice:focus-visible {
    outline: 2px solid var(--stamp);
    outline-offset: 2px;
  }

  .theme-choice-preview {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 48px;
    color: var(--ink);
    background: var(--paper);
    border-radius: 1px;
  }

  .theme-choice-icon {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    color: var(--stamp);
  }

  .theme-choice-preview[data-theme="moon"] .theme-choice-icon { color: var(--accent); }
  .theme-choice-preview[data-theme="ink"] .theme-choice-icon,
  .theme-choice-preview[data-theme="dusk"] .theme-choice-icon { color: var(--ink); }

  .theme-choice-sample {
    font-family: var(--font-kai);
    font-size: 16px;
    line-height: 1;
    letter-spacing: 0.03em;
  }

  .theme-choice-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 5px 3px 0;
    font-family: var(--font-serif);
    font-size: 12px;
    line-height: 1.6;
  }

  .theme-choice-check {
    color: var(--stamp);
    visibility: hidden;
  }

  .theme-choice[aria-pressed="true"] .theme-choice-check { visibility: visible; }

  @keyframes theme-panel-in {
    from { opacity: 0; transform: translate(var(--theme-panel-offset, 0px), -5px); }
    to { opacity: 1; transform: translate(var(--theme-panel-offset, 0px), 0); }
  }

  .theme-icon {
    position: relative;
    z-index: 1;
    display: none;
    place-items: center;
    width: 24px;
    height: 24px;
    font-size: 13px;
    line-height: 1;
  }

  .theme-icon.is-active {
    display: grid;
  }

  .theme-cycle-button[data-current-theme="paper"] .theme-icon,
  .theme-cycle-button[data-current-theme="celadon"] .theme-icon,
  .theme-cycle-button[data-current-theme="bamboo"] .theme-icon,
  .theme-cycle-button[data-current-theme="lotus"] .theme-icon {
    color: var(--stamp);
  }

  .theme-cycle-button[data-current-theme="moon"] .theme-icon {
    color: var(--accent);
  }

  .theme-cycle-button[data-current-theme="sand"] .theme-icon {
    color: var(--stamp);
  }

  .theme-cycle-button[data-current-theme="ink"] .theme-icon,
  .theme-cycle-button[data-current-theme="dusk"] .theme-icon {
    color: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-cycle-button::before,
    .theme-cycle-button::after {
      transition: none;
    }
    .theme-picker-panel { animation: none; }
    .theme-choice { transition: none; }
  }
</style>
