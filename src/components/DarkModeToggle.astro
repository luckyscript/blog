---
---
<mode-toggle class="inkrain-mode-toggle">
  <button
    class="toggle-btn"
    role="switch"
    type="button"
    tabindex="0"
    aria-checked="false"
    data-headlessui-state=""
  >
    <span class="sr-only">Toggle dark mode</span>
    <span class="toggle-track" aria-hidden="true">
      <i class="fa-solid fa-sun toggle-icon toggle-sun"></i>
      <i class="fa-solid fa-moon toggle-icon toggle-moon"></i>
      <span class="toggle-dot invisible"></span>
    </span>
  </button>
</mode-toggle>

<script>
  function updateHTMLTheme(mode: "light" | "dark") {
    const themeColorMetaTag = document.head.querySelector(
      'meta[name="theme-color"]'
    );

    if (mode === "dark") {
      document.documentElement.classList.remove("light");
      document.documentElement.classList.add("dark");
      if (themeColorMetaTag) {
        // @ts-ignore
        themeColorMetaTag.content = "#15171a";
      }
    } else {
      document.documentElement.classList.remove("dark");
      document.documentElement.classList.add("light");
      if (themeColorMetaTag) {
        // @ts-ignore
        themeColorMetaTag.content = "#f5f1e8";
      }
    }
  }
  function sendMessage(message: any) {
    const iframe = document.querySelector('iframe.giscus-frame') as any;
    if (!iframe) {
      return;
    }
    iframe.contentWindow.postMessage({ giscus: message }, 'https://giscus.app');
  }

  function updateStorageTheme(mode: "light" | "dark") {
    sendMessage({
      setConfig: {
        theme: mode
      }
    });
    if (mode === "dark") {
      localStorage.setItem("theme", "dark");
    } else {
      localStorage.setItem("theme", "light");
    }
  }

  function updateToggleVisual(iconElem: Element, mode: "light" | "dark") {
    if (mode === "dark") {
      iconElem.classList.remove("light");
      iconElem.classList.add("dark");
    } else {
      iconElem.classList.remove("dark");
      iconElem.classList.add("light");
    }
  }

  function setThemeWithTransition(mode: "light" | "dark", iconElem: Element) {
    const root = document.documentElement;
    const transitionClass = mode === "dark" ? "theme-turning-dark" : "theme-turning-light";
    const cleanupTransitionClass = () => {
      root.classList.remove("theme-turning-dark", "theme-turning-light");
    };
    const applyTheme = () => {
      updateHTMLTheme(mode);
      updateStorageTheme(mode);
      updateToggleVisual(iconElem, mode);
    };

    if (
      typeof document.startViewTransition !== "function" ||
      window.matchMedia("(prefers-reduced-motion: reduce)").matches
    ) {
      applyTheme();
      return;
    }

    cleanupTransitionClass();
    root.classList.add(transitionClass);
    const transition = document.startViewTransition(applyTheme);
    window.setTimeout(cleanupTransitionClass, 260);
    transition.finished.finally(() => {
      cleanupTransitionClass();
    });
  }

  class ModeToggle extends HTMLElement {
    constructor() {
      super();
      let currentMode: "light" | "dark" =
        document.documentElement.classList.contains("dark") ? "dark" : "light";

      const toggle = this.querySelector("button");
      const iconElem = toggle?.querySelector(".toggle-dot");

      if (iconElem) {
        if (currentMode === "dark") {
          iconElem.classList.remove("light");
          iconElem.classList.add("dark");
        } else {
          iconElem.classList.add("light");
        }

        iconElem.classList.remove("invisible");

        toggle?.addEventListener("click", () => {
          if (currentMode === "dark") {
            const modeToSwitch = "light";
            setThemeWithTransition(modeToSwitch, iconElem);
            currentMode = modeToSwitch;
          } else {
            const modeToSwitch = "dark";
            setThemeWithTransition(modeToSwitch, iconElem);
            currentMode = modeToSwitch;
          }

          if (!iconElem.classList.contains("duration-300")) {
            iconElem.classList.add("duration-300");
          }
        });
      }
    }
  }

  if (!customElements.get("mode-toggle")) {
    customElements.define("mode-toggle", ModeToggle);
  }
</script>

<style>
  .inkrain-mode-toggle {
    display: inline-flex;
  }
  .toggle-btn {
    position: relative;
    background: color-mix(in srgb, var(--panel) 72%, transparent);
    border: 1px solid rgb(var(--color-border-soft));
    width: 58px;
    height: 32px;
    border-radius: 999px;
    cursor: pointer;
    padding: 3px;
    transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
    box-shadow: inset 0 1px 2px rgb(var(--color-ink) / 0.08);
  }
  .toggle-btn:hover {
    border-color: rgb(var(--color-stamp) / 0.5);
    box-shadow: var(--focus-ring);
  }
  .toggle-track {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
  }
  .toggle-dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    background: var(--panel);
    border: 1px solid rgb(var(--color-border));
    box-shadow: 0 4px 12px rgb(var(--color-ink) / 0.14);
    transition: transform 0.22s ease, background-color 0.22s ease, border-color 0.22s ease;
  }
  .toggle-dot::before {
    display: none;
  }
  .toggle-icon {
    position: absolute;
    top: 50%;
    z-index: 1;
    transform: translateY(-50%);
    font-size: 10px;
    line-height: 1;
    color: rgb(var(--color-ink-muted));
    pointer-events: none;
    transition: color 0.2s ease, opacity 0.2s ease;
  }
  .toggle-sun {
    left: 7px;
  }
  .toggle-moon {
    right: 7px;
  }
  .toggle-dot.light {
    transform: translateX(0);
    background: color-mix(in srgb, var(--stamp) 16%, var(--panel));
  }
  .toggle-dot.dark {
    transform: translateX(26px);
    background: color-mix(in srgb, var(--accent) 22%, var(--panel));
    border-color: rgb(var(--color-stamp) / 0.58);
  }
  html.dark .toggle-sun {
    opacity: 0.45;
  }
  html.dark .toggle-moon {
    color: rgb(var(--color-accent));
  }
  html:not(.dark) .toggle-sun {
    color: rgb(var(--color-stamp));
  }
  html:not(.dark) .toggle-moon {
    opacity: 0.45;
  }
</style>
