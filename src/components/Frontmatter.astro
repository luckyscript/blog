---
const { frontmatter } = Astro.props;
---

<footer class="article-meta" aria-label="文章分类与标签">
  <div class="meta-heading" aria-hidden="true">
    <span>篇末索引</span>
    <i></i>
    <b>INDEX</b>
  </div>

  <dl class="meta-grid">
    {frontmatter.category && (
      <div class="meta-row">
        <dt>分类</dt>
        <dd>
          <a href={`/category/${frontmatter.category}`} class="meta-category unset">
            <span class="meta-category-seal" aria-hidden="true">类</span>
            <span class="meta-category-name">{frontmatter.category}</span>
          </a>
        </dd>
      </div>
    )}
    {frontmatter.tags && frontmatter.tags.length > 0 && (
      <div class="meta-row">
        <dt>标签</dt>
        <dd class="meta-tags">
          {frontmatter.tags.map((tag: string) => (
            <span class="meta-tag"><span aria-hidden="true">#</span>{tag}</span>
          ))}
        </dd>
      </div>
    )}
  </dl>

  {frontmatter.update && (
    <div class="meta-updated">
      <span>校记</span>
      <time datetime={new Date(frontmatter.update).toISOString()}>
        {new Date(frontmatter.update).toLocaleDateString("zh-CN", {
          year: "numeric",
          month: "short",
          day: "numeric",
        })}
      </time>
    </div>
  )}
</footer>

<style>
  .article-meta {
    position: relative;
    max-width: 720px;
    margin: 0 auto 72px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .article-meta::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    width: 52px;
    height: 2px;
    background: var(--stamp);
  }

  .meta-heading {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
  }

  .meta-heading > span {
    color: var(--ink-soft);
    font-family: var(--font-kai);
    font-size: 14px;
    letter-spacing: 0;
  }

  .meta-heading > i {
    width: 34px;
    height: 1px;
    background: var(--border);
  }

  .meta-heading > b {
    font-weight: 400;
  }

  .meta-grid {
    margin: 0;
  }

  .meta-row {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 18px;
    align-items: center;
    min-height: 66px;
    padding: 13px 0;
    border-bottom: 1px solid var(--border-soft);
  }

  .meta-row dt {
    margin: 0;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
  }

  .meta-row dd {
    margin: 0;
  }

  .meta-category {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--ink);
    background-image: none !important;
  }

  .meta-category-seal {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    color: var(--stamp);
    border: 1px solid color-mix(in srgb, var(--stamp) 72%, transparent);
    font-family: var(--font-kai);
    font-size: 13px;
    transform: rotate(-2deg);
    transition: color 160ms ease, background-color 160ms ease, transform 160ms ease;
  }

  .meta-category-name {
    padding-bottom: 2px;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-serif);
    font-size: 17px;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .meta-category:hover .meta-category-seal {
    color: var(--paper);
    background: var(--stamp);
    transform: rotate(0deg);
  }

  .meta-category:hover .meta-category-name {
    color: var(--stamp);
    border-color: var(--stamp);
  }

  .meta-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }

  .meta-tag {
    display: inline-flex;
    gap: 4px;
    padding: 2px 0;
    color: var(--ink-soft);
    border-bottom: 1px solid var(--border-soft);
    font-family: var(--font-serif);
    font-size: 14px;
    line-height: 1.5;
  }

  .meta-tag > span {
    color: var(--stamp);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .meta-updated {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 16px;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.06em;
  }

  .meta-updated > span {
    color: var(--stamp);
    font-family: var(--font-kai);
    font-size: 11px;
    letter-spacing: 0;
  }

  @media (max-width: 560px) {
    .article-meta {
      margin-bottom: 52px;
    }

    .meta-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
      padding: 16px 0;
    }

    .meta-tags {
      gap: 8px 16px;
    }
  }
</style>
