---
const items = [
  { char: "游", text: "御三家全制霸 · 次元壁穿梭者" },
  { char: "骑", text: "跨上铁骑追逐地平线的冒险家" },
  { char: "码", text: "用键盘编织代码的二进制诗人" },
  { char: "球", text: "二十年美凌格 · 银河战舰永不沉没" },
  { char: "墨", text: "执钢笔写春秋的器物美学家" },
];
---

<div class="desc-grid">
  {items.map((item) => (
    <div class="desc-item">
      <span class="desc-mark" aria-hidden="true">{item.char}</span>
      <p>{item.text}</p>
    </div>
  ))}
</div>

<style>
  .desc-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 36px;
  }

  .desc-item {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    align-items: center;
    gap: 13px;
    min-height: 68px;
    border-bottom: 1px solid var(--border-soft);
  }

  .desc-mark {
    display: grid;
    place-items: center;
    width: 30px;
    aspect-ratio: 1;
    color: var(--stamp);
    border: 1px solid color-mix(in srgb, var(--stamp) 56%, transparent);
    font-family: var(--font-kai);
  }

  p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 14px;
    line-height: 1.65;
  }

  @media (max-width: 680px) {
    .desc-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
