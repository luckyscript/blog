---
import DarkModeToggle from "./DarkModeToggle.astro";
import HeaderLink from "./HeaderLink.astro";
import { NAV } from "../config";

const navMarks: Record<string, string> = {
  首页: "雨",
  生活: "文",
  笔记: "记",
  链接: "链",
  PPT: "演",
  观察: "观",
  碎碎念: "言",
};
---

<header class="site-header" aria-label="网站导航">
  <a class="unset skip-link" href="#main">跳到正文</a>

  <div class="header-inner">
    <a class="unset brand" href="/" aria-label="下雨就像弹钢琴">
      <span class="brand-seal" aria-hidden="true">雨</span>
      <span class="brand-text">
        <span class="brand-cn">下雨就像弹钢琴</span>
        <span class="brand-en">Rain on Piano</span>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="主导航">
      {Object.entries(NAV).map(([name, href]) => (
        typeof href === "string" && <HeaderLink href={href}>{name}</HeaderLink>
      ))}
    </nav>

    <div class="header-actions">
      <DarkModeToggle />
      <button
        class="menu-button"
        id="mobile-menu-open"
        type="button"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="打开导航"
      >
        <i class="fa-solid fa-bars" aria-hidden="true"></i>
      </button>
    </div>
  </div>
</header>

<section id="mobile-menu" class="mobile-menu-panel" aria-hidden="true">
  <div class="mobile-menu-drawer">
    <div class="mobile-menu-head">
      <span>
        <span class="drawer-kicker">Rain on Piano</span>
        <strong>墨雨</strong>
      </span>
      <button id="mobile-menu-close" type="button" aria-label="关闭导航">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>
    </div>
    <nav aria-label="移动端导航">
      <ul class="unset">
        {Object.entries(NAV).map(([name, href]) => (
          typeof href === "string" && (
            <li>
              <HeaderLink href={href}>
                <span class="mobile-nav-mark" aria-hidden="true">{navMarks[name] || name.slice(0, 1)}</span>
                <span>{name}</span>
              </HeaderLink>
            </li>
          )
        ))}
      </ul>
    </nav>
  </div>
</section>

<script>
  const openButton = document.querySelector<HTMLButtonElement>("#mobile-menu-open");
  const closeButton = document.querySelector<HTMLButtonElement>("#mobile-menu-close");
  const menu = document.querySelector<HTMLElement>("#mobile-menu");

  const setMenu = (open: boolean) => {
    menu?.classList.toggle("is-open", open);
    menu?.setAttribute("aria-hidden", String(!open));
    openButton?.setAttribute("aria-expanded", String(open));
    document.body.style.overflow = open ? "hidden" : "";
    if (open) closeButton?.focus();
  };

  openButton?.addEventListener("click", () => setMenu(true));
  closeButton?.addEventListener("click", () => setMenu(false));
  menu?.addEventListener("click", (event) => {
    if (event.target === menu) setMenu(false);
  });
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMenu(false));
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu?.classList.contains("is-open")) setMenu(false);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    border-top: 3px solid var(--stamp);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(14px);
  }

  .header-inner {
    width: min(100% - 40px, 1120px);
    min-height: 68px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(210px, 1fr) auto auto;
    align-items: center;
    gap: 22px;
  }

  .skip-link {
    position: absolute;
    left: 50%;
    top: -100px;
    transform: translateX(-50%);
    z-index: 50;
    padding: 8px 16px;
    color: var(--paper);
    background: var(--ink);
  }

  .skip-link:focus {
    top: 8px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    width: max-content;
    min-width: 0;
    color: var(--ink);
    background-image: none !important;
  }

  .brand-seal {
    display: grid;
    place-items: center;
    width: 36px;
    aspect-ratio: 1;
    flex: 0 0 auto;
    color: var(--paper);
    background: var(--stamp);
    border-radius: 2px;
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--paper) 32%, transparent);
    font-family: var(--font-kai);
    font-size: 21px;
  }

  .brand-text {
    display: grid;
    line-height: 1.25;
  }

  .brand-cn {
    font-family: var(--font-serif);
    font-size: 15px;
    font-weight: 600;
  }

  .brand-en,
  .drawer-kicker {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .menu-button,
  .mobile-menu-head button {
    display: none;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--border);
    color: var(--ink);
    background: transparent;
    cursor: pointer;
  }

  .mobile-menu-panel {
    position: fixed;
    inset: 0;
    z-index: 40;
    overflow: hidden;
    visibility: hidden;
    background: rgb(20 22 22 / 0.48);
    opacity: 0;
    transition: opacity 180ms ease, visibility 180ms ease;
  }

  .mobile-menu-panel.is-open {
    visibility: visible;
    opacity: 1;
  }

  .mobile-menu-drawer {
    width: min(86vw, 360px);
    min-height: 100%;
    margin-left: auto;
    padding: 26px;
    color: var(--ink);
    background: var(--paper);
    border-left: 1px solid var(--border);
    transform: translateX(100%);
    transition: transform 220ms ease;
  }

  .mobile-menu-panel.is-open .mobile-menu-drawer {
    transform: translateX(0);
  }

  .mobile-menu-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }

  .mobile-menu-head > span {
    display: grid;
  }

  .mobile-menu-head strong {
    font-family: var(--font-kai);
    font-size: 28px;
    font-weight: 400;
  }

  .mobile-menu-drawer ul {
    margin: 20px 0 0;
    padding: 0;
  }

  .mobile-menu-drawer li {
    padding: 0 !important;
    border-bottom: 1px solid var(--border-soft);
  }

  .mobile-menu-drawer li::before {
    display: none;
  }

  .mobile-nav-mark {
    display: grid;
    place-items: center;
    width: 28px;
    aspect-ratio: 1;
    color: var(--stamp);
    border: 1px solid color-mix(in srgb, var(--stamp) 48%, transparent);
    font-family: var(--font-kai);
  }

  @media (max-width: 980px) {
    .desktop-nav {
      display: none;
    }

    .header-inner {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .header-actions {
      grid-column: 2;
    }

    .menu-button,
    .mobile-menu-head button {
      display: grid;
    }
  }

  @media (max-width: 560px) {
    .header-inner {
      width: min(100% - 24px, 1120px);
      min-height: 62px;
      gap: 10px;
    }

    .brand-text {
      display: none;
    }

    .brand-seal {
      width: 34px;
    }

    .header-actions {
      gap: 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu-panel,
    .mobile-menu-drawer {
      transition: none;
    }
  }
</style>
