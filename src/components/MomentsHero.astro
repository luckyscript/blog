---
const { title = '碎碎念', eyebrow = '日常 · 片段', description = '日常片段、链接、现场感，以及那些还没有长成文章的想法。' } = Astro.props;
---
<section class="moments-hero">
  <div class="moments-title"><p class="moments-eyebrow"><span class="moments-seal" aria-hidden="true">记</span>{eyebrow}</p><h1>{title}</h1></div>
  <div class="moments-intro">
    <p>{description}</p>
  </div>
</section>
<style>
  .moments-hero{max-width:840px;margin:0 auto;display:grid;grid-template-columns:minmax(220px,.85fr) minmax(0,1.15fr);gap:40px;align-items:end;padding:0 0 30px;border-bottom:1px solid var(--border)}
  .moments-eyebrow{display:flex;gap:11px;align-items:center;margin:0 0 16px;color:var(--ink-soft);font-family:var(--font-serif);font-size:13px;letter-spacing:.13em}
  .moments-seal{display:grid;place-items:center;width:25px;height:28px;border:1px solid color-mix(in srgb,var(--stamp) 60%,transparent);color:var(--stamp);font-family:var(--font-kai);font-size:18px;letter-spacing:0;transform:rotate(-4deg)}
  h1{margin:0;color:var(--ink);font-family:var(--font-kai);font-size:clamp(3rem,6.8vw,4.8rem);font-weight:400;line-height:1.1;overflow-wrap:anywhere}
  .moments-intro>p{max-width:410px;margin:0;color:var(--ink-soft);font-size:15px;line-height:1.9}
  @media(max-width:680px){.moments-hero{grid-template-columns:1fr;gap:18px;padding-bottom:24px}.moments-eyebrow{margin-bottom:12px}.moments-intro>p{font-size:14px;max-width:32em}}
</style>
