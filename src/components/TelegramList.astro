---
import Item from "src/components/TelegramItem.astro";

const {
  channel,
  after = false,
  before = false,
  compact = false,
} = Astro.props;

const posts = channel?.posts ?? [];

const beforeCursor = posts[posts.length - 1]?.id;
const afterCursor = posts[0]?.id;
const hasOlder = before && beforeCursor && Number(beforeCursor) > 1;
const hasNewer = after && afterCursor;

---

<div class="telegram-section">
  <div class="telegram-header">
    <span class="telegram-dot"></span>
    <span>最近更新</span>
  </div>
  <div class:list={["items", "moments-feed", compact && "moments-feed-compact"]}>
    {posts.map(post => <Item post={post} compact={compact} />)}
  </div>
</div>

{
  hasOlder || hasNewer ? (
    <nav class="moments-pagination" aria-label="碎碎念分页">
      {hasOlder ? <a class="unset btn-ghost moment-page-link" href={`/moments/before/${beforeCursor}`}>更早</a> : null}
      {hasNewer ? <a class="unset btn-ghost moment-page-link" href={`/moments/after/${afterCursor}`}>更新</a> : null}
    </nav>
  ) : null
}

<style>
  .telegram-section {
    margin-top: 1rem;
    opacity: 0;
    animation: fadeUp 0.8s ease-out 1s forwards;
  }
  .telegram-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: rgb(var(--color-ink-muted) / 0.7);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-family: "JetBrains Mono", monospace;
    margin-bottom: 1.5rem;
  }
  .telegram-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgb(var(--color-stamp));
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>
