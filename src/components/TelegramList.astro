---
import Item from "src/components/TelegramItem.astro";
import MomentsControls from './MomentsControls.astro';

const { channel, after = false, before = false, compact = false } = Astro.props;
const posts = channel?.posts ?? [];
const beforeCursor = posts[posts.length - 1]?.id;
const afterCursor = posts[0]?.id;
const hasOlder = before && beforeCursor && channel.hasOlder;
const hasNewer = after && afterCursor && channel.hasNewer;
const params = new URLSearchParams();
if (channel.query) params.set('q', channel.query);
if (channel.platform) params.set('platform', channel.platform);
const query = params.size ? `?${params}` : '';
---

<div class:list={["telegram-section", compact && "telegram-section-compact"]}>
  {!compact && <MomentsControls channel={channel} />}
  <div class:list={["items", "moments-feed", compact && "moments-feed-compact"]}>
    {posts.map((post) => <Item post={post} compact={compact} />)}
    {posts.length === 0 && <div class="moment-empty"><p>这里暂时没有找到相关片段。</p><a class="unset" href="/moments">回到全部碎碎念</a></div>}
  </div>
</div>

{hasOlder || hasNewer ? (
  <nav class="moments-pagination" aria-label="碎碎念分页">
    {hasNewer ? <a class="unset moment-page-link" href={`/moments/after/${afterCursor}${query}`}>← 更近的片段</a> : <span />}
    {hasOlder ? <a class="unset moment-page-link" href={`/moments/before/${beforeCursor}${query}`}>翻到更早 →</a> : <span />}
  </nav>
) : null}

<style>
  .telegram-section {
    max-width:840px;
    margin:0 auto;
  }

  .telegram-section-compact {
    margin-top: 0;
  }

  .telegram-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .telegram-header span:first-child {
    padding: 2px 5px;
    color: var(--stamp);
    border: 1px solid color-mix(in srgb, var(--stamp) 48%, transparent);
    font-family: var(--font-kai);
    letter-spacing: 0;
  }
</style>
