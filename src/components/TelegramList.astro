---
import Item from "src/components/TelegramItem.astro";

const {
  channel,
  after = false,
  before = false,
  compact = false,
} = Astro.props;

const posts = channel?.posts ?? [];

const beforeCursor = posts[posts.length - 1]?.id;
const afterCursor = posts[0]?.id;
const hasOlder = before && beforeCursor && Number(beforeCursor) > 1;
const hasNewer = after && afterCursor;

---

<div class:list={["moments-feed", compact && "moments-feed-compact"]}>
  {posts.map(post => <Item post={post} compact={compact} />)}
</div>

{
  hasOlder || hasNewer ? (
    <nav class="moments-pagination" aria-label="碎碎念分页">
      {hasOlder ? <a class="unset moment-page-link" href={`/moments/before/${beforeCursor}`}>更早</a> : null}
      {hasNewer ? <a class="unset moment-page-link" href={`/moments/after/${afterCursor}`}>更新</a> : null}
    </nav>
  ) : null
}
