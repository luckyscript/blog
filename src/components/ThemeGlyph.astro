---
import type { InkRainTheme } from "../lib/themes";
interface Props { theme: InkRainTheme; }
const { theme } = Astro.props;
---

{theme === "paper" && (
<span class="theme-glyph theme-glyph-paper"></span>
 )}

{theme === "moon" && (
<span class="theme-glyph theme-glyph-moon"></span>
 )}

{theme === "sand" && (
<span class="theme-glyph theme-glyph-sand">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="17" cy="6" r="2" fill="currentColor" stroke="none" />
          <path d="M2 17c4-7 7-8 12-2 3-3 5-3 8 0M2 20h20" />
          <path d="M8 12c2 4 5 5 9 5" />
        </svg>
      </span>
 )}

{theme === "ink" && (
<span class="theme-glyph theme-glyph-ink"></span>
 )}

{theme === "celadon" && (
<span class="theme-glyph theme-glyph-art">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 3h6M10 3v5c0 3-5 4-5 8a6 6 0 0 0 2 5h10a6 6 0 0 0 2-5c0-4-5-5-5-8V3M6 13h12M8 18c2-2 6-2 8 0" />
        </svg>
      </span>
 )}

{theme === "bamboo" && (
<span class="theme-glyph theme-glyph-art">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 3 9 21M8 8h4M8 15h3M16 6l1 15M15 12h4M10 11C6 5 3 7 3 7c0 3 3 5 7 4ZM16 10c1-5 5-6 5-6 1 3-1 6-5 6Z" />
        </svg>
      </span>
 )}

{theme === "lotus" && (
<span class="theme-glyph theme-glyph-art">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 17c-5-3-5-8 0-13 5 5 5 10 0 13ZM12 17C5 18 2 13 3 8c4 0 7 3 9 9ZM12 17c7 1 10-4 9-9-4 0-7 3-9 9ZM4 21c4-2 12-2 16 0" />
        </svg>
      </span>
 )}

{theme === "dusk" && (
<span class="theme-glyph theme-glyph-art">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="m2 20 6-9 5 6 3-4 6 7H2ZM19 3a4 4 0 1 0 2 6 4 4 0 0 1-2-6Z" />
          <circle cx="8" cy="5" r="0.8" fill="currentColor" stroke="none" />
        </svg>
      </span>
 )}

<style>
  .theme-glyph {
    position: relative;
    display: block;
    color: currentColor;
  }

  .theme-glyph-paper {
    width: 13px;
    height: 16px;
    border: 1.5px solid currentColor;
    box-sizing: border-box;
    transform: rotate(-2deg);
  }

  .theme-glyph-paper::before {
    content: "";
    position: absolute;
    top: 4px;
    right: 2px;
    left: 3px;
    height: 1px;
    background: currentColor;
    box-shadow: 0 4px 0 currentColor;
    opacity: 0.72;
  }

  .theme-glyph-moon {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    box-shadow: 4px 1px 0 0 currentColor;
    transform: translate(-2px, -1px) rotate(-12deg);
  }

  .theme-glyph-ink {
    width: 11px;
    height: 14px;
    border-radius: 9px 9px 9px 2px;
    background: currentColor;
    transform: rotate(45deg) translate(-1px, 1px);
  }

  .theme-glyph-sand,
  .theme-glyph-art {
    width: 20px;
    height: 20px;
  }

  .theme-glyph-sand svg,
  .theme-glyph-art svg {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
