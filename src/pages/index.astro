---
import PageMeta from "../components/PageMeta.astro";
import PageLayout from "../layouts/PageLayout.astro";
import Intro from "../components/Intro.astro";
import PersonalDesc from "../components/PersonalDesc.astro";
import TelegramList from "../components/TelegramList.astro";
import { SITE_TITLE } from "../config";
import { getChannelInfo } from "../lib/telegram";
import { readBlog } from "../lib/markdoc/read";
import { blog } from "../lib/markdoc/frontmatter.schema";

const fallbackChannel = {
  posts: [],
  title: "碎碎念",
  description: "",
};

const [channel, blogGroups] = await Promise.all([
  Promise.race([
    getChannelInfo(Astro),
    new Promise((resolve) => setTimeout(() => resolve(fallbackChannel), 3000)),
  ]).catch(() => fallbackChannel),
  readBlog({ frontmatterSchema: blog }),
]);

const recentPosts = blogGroups
  .flatMap((group) => group.posts.map((post) => ({ ...post, year: group.year })))
  .filter((post) => post.frontmatter.draft !== true)
  .sort(
    (a, b) =>
      new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf()
  )
  .slice(0, 3);

const compactChannel = {
  ...channel,
  posts: (channel?.posts ?? []).slice(0, 3),
};

export const prerender = true;
---

<PageLayout>
  <PageMeta title={`${SITE_TITLE} | Home`} slot="meta" />
  <Fragment slot="main">
    <Intro />

    <section class="home-section">
      <header class="home-section-head">
        <span class="home-section-index">壹 · Essays</span>
        <h2>近日文章</h2>
      </header>
      <div class="home-section-content recent-posts">
        {recentPosts.map((post) => {
          const date = new Date(post.frontmatter.date).toLocaleDateString("zh-CN", {
            month: "short",
            day: "numeric",
          });
          const href = post.frontmatter.external
            ? post.frontmatter.url
            : `/blog/${post.year}/${post.slug}`;
          return (
            <a class="unset recent-post" href={href} target={post.frontmatter.external ? "_blank" : undefined}>
              <time datetime={post.frontmatter.date.toISOString()}>{date}</time>
              <strong>{post.frontmatter.title}</strong>
              <span aria-hidden="true">读</span>
            </a>
          );
        })}
        <a class="unset section-more" href="/blog">查看全部文章</a>
      </div>
    </section>

    <section class="home-section">
      <header class="home-section-head">
        <span class="home-section-index">贰 · Moments</span>
        <h2>碎碎念</h2>
      </header>
      <div class="home-section-content" data-dynamic-moments>
        <TelegramList channel={compactChannel} compact={true} />
        <a class="unset section-more" href="/moments">去碎碎念</a>
      </div>
    </section>

    <section class="home-section">
      <header class="home-section-head">
        <span class="home-section-index">叁 · About</span>
        <h2>关于我</h2>
      </header>
      <div class="home-section-content">
        <PersonalDesc />
      </div>
    </section>
  </Fragment>
</PageLayout>

<style>
  .home-section {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 44px;
    padding: 56px 0;
    border-bottom: 1px solid var(--border);
  }

  .home-section-head h2 {
    margin: 7px 0 0;
    color: var(--ink);
    font-family: var(--font-kai);
    font-size: 28px;
    font-weight: 400;
    line-height: 1.2;
  }

  .home-section-index {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .recent-posts {
    display: grid;
  }

  .recent-post {
    display: grid;
    grid-template-columns: 82px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 20px;
    min-height: 66px;
    padding: 17px 0;
    color: var(--ink);
    border-bottom: 1px solid var(--border-soft);
    background-image: none !important;
  }

  .recent-post:first-child {
    padding-top: 0;
  }

  .recent-post time {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.05em;
  }

  .recent-post strong {
    font-size: 18px;
    font-weight: 500;
    transition: color 150ms ease;
  }

  .recent-post > span {
    color: var(--stamp);
    font-family: var(--font-kai);
  }

  .recent-post:hover strong {
    color: var(--stamp);
  }

  .section-more {
    display: inline-flex;
    width: max-content;
    margin-top: 22px;
    padding-bottom: 2px;
    color: var(--stamp);
    border-bottom: 1px solid currentColor;
    font-family: var(--font-sans);
    font-size: 12px;
    background-image: none !important;
  }

  @media (max-width: 760px) {
    .home-section {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
      padding: 42px 0;
    }

    .recent-post {
      grid-template-columns: 72px minmax(0, 1fr);
      gap: 14px;
    }

    .recent-post > span {
      display: none;
    }

    .recent-post strong {
      font-size: 16px;
    }
  }
</style>

<script>
  const root = document.querySelector("[data-dynamic-moments]");
  const feed = root?.querySelector(".moments-feed-compact");

  function formatMomentTime(datetime) {
    const date = new Date(datetime);
    const diff = date.valueOf() - Date.now();
    const absDiff = Math.abs(diff);
    const minute = 60 * 1000;
    const hour = 60 * minute;
    const day = 24 * hour;
    const week = 7 * day;

    if (absDiff < week) {
      const formatter = new Intl.RelativeTimeFormat("zh-CN", { numeric: "auto" });
      if (absDiff < hour) {
        return formatter.format(Math.round(diff / minute), "minute");
      }
      if (absDiff < day) {
        return formatter.format(Math.round(diff / hour), "hour");
      }
      return formatter.format(Math.round(diff / day), "day");
    }

    return new Intl.DateTimeFormat("zh-CN", {
      month: "short",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    }).format(date);
  }

  function renderMoment(post) {
    const article = document.createElement("article");
    article.className = "telegram-item telegram-item-compact";
    article.style.viewTransitionName = `post-${post.id}`;

    const timeWrapper = document.createElement("div");
    timeWrapper.className = "time-wrapper";

    const link = document.createElement("a");
    link.className = "unset telegram-permalink";
    link.href = `/moments/posts/${post.id}`;
    link.setAttribute("aria-label", `打开碎碎念 ${post.id}`);

    const time = document.createElement("time");
    time.dateTime = post.datetime;
    time.title = formatMomentTime(post.datetime);
    time.textContent = formatMomentTime(post.datetime);

    const content = document.createElement("div");
    content.className = "text-box telegram-content";
    content.innerHTML = post.content;

    link.append(time);
    timeWrapper.append(link);
    article.append(timeWrapper, content);
    return article;
  }

  async function refreshMoments() {
    if (!feed) {
      return;
    }

    const response = await fetch("/api/moments.json", { cache: "no-store" });
    if (!response.ok) {
      return;
    }

    const { posts } = await response.json();
    if (!Array.isArray(posts) || posts.length === 0) {
      return;
    }

    feed.replaceChildren(...posts.map(renderMoment));
  }

  refreshMoments().catch(() => {});
</script>
