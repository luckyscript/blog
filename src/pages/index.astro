---
import PageMeta from "../components/PageMeta.astro";
import PageLayout from "../layouts/PageLayout.astro";
import Intro from "../components/Intro.astro";
import PersonalDesc from "../components/PersonalDesc.astro";
import { SITE_TITLE } from "../config";
import { momentChannel } from "../lib/moments/store";
import { readBlog } from "../lib/markdoc/read";
import { blog } from "../lib/markdoc/frontmatter.schema";

const [channel, blogGroups] = await Promise.all([
  momentChannel({ limit: 3 }),
  readBlog({ frontmatterSchema: blog }),
]);

const recentPosts = blogGroups
  .flatMap((group) => group.posts.map((post) => ({ ...post, year: group.year })))
  .filter((post) => post.frontmatter.draft !== true)
  .sort(
    (a, b) =>
      new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf()
  )
  .slice(0, 3);

const compactChannel = {
  ...channel,
  posts: (channel?.posts ?? []).slice(0, 3),
};

function formatMomentDate(datetime) {
  return new Date(datetime).toLocaleDateString("zh-CN", {
    month: "short",
    day: "numeric",
  });
}

function getMomentExcerpt(post) {
  const text = post.text || post.title || "";
  return text.trim() || "打开这条碎碎念";
}

export const prerender = false;
---

<PageLayout>
  <PageMeta title={`${SITE_TITLE} | Home`} slot="meta" />
  <Fragment slot="main">
    <Intro />

    <section class="home-section">
      <header class="home-section-head">
        <span class="home-section-index">壹 · Essays</span>
        <h2>近日文章</h2>
      </header>
      <div class="home-section-content recent-posts">
        {recentPosts.map((post) => {
          const date = new Date(post.frontmatter.date).toLocaleDateString("zh-CN", {
            month: "short",
            day: "numeric",
          });
          const href = post.frontmatter.external
            ? post.frontmatter.url
            : `/blog/${post.year}/${post.slug}`;
          return (
            <a class="unset recent-post" href={href} target={post.frontmatter.external ? "_blank" : undefined}>
              <time datetime={post.frontmatter.date.toISOString()}>{date}</time>
              <strong>{post.frontmatter.title}</strong>
              <span aria-hidden="true">读</span>
            </a>
          );
        })}
        <a class="unset section-more" href="/blog">查看全部文章</a>
      </div>
    </section>

    <section class="home-section">
      <header class="home-section-head">
        <span class="home-section-index">贰 · Moments</span>
        <h2>碎碎念</h2>
      </header>
      <div class="home-section-content home-moments" data-dynamic-moments>
        <div class="home-moments-list" data-dynamic-moments-list>
          {compactChannel.posts.length === 0 && <p>暂时没有碎碎念。</p>}
          {compactChannel.posts.map((post) => (
            <a class="unset home-moment" href={`/moments/posts/${post.id}`}>
              <time datetime={post.datetime}>{formatMomentDate(post.datetime)}</time>
              <span>{getMomentExcerpt(post)}</span>
            </a>
          ))}
        </div>
        <a class="unset section-more" href="/moments">去碎碎念</a>
      </div>
    </section>

    <section class="home-section">
      <header class="home-section-head">
        <span class="home-section-index">叁 · About</span>
        <h2>关于我</h2>
      </header>
      <div class="home-section-content">
        <PersonalDesc />
      </div>
    </section>
  </Fragment>
</PageLayout>

<style>
  .home-section {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 44px;
    padding: 56px 0;
    border-bottom: 1px solid var(--border);
  }

  .home-section-head h2 {
    margin: 7px 0 0;
    color: var(--ink);
    font-family: var(--font-kai);
    font-size: 28px;
    font-weight: 400;
    line-height: 1.2;
  }

  .home-section-index {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .recent-posts {
    display: grid;
  }

  .recent-post {
    display: grid;
    grid-template-columns: 82px minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 20px;
    min-height: 66px;
    padding: 17px 0;
    color: var(--ink);
    border-bottom: 1px solid var(--border-soft);
    background-image: none !important;
  }

  .recent-post:first-child {
    padding-top: 0;
  }

  .recent-post time {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.05em;
  }

  .recent-post strong {
    font-size: 18px;
    font-weight: 500;
    transition: color 150ms ease;
  }

  .recent-post > span {
    color: var(--stamp);
    font-family: var(--font-kai);
  }

  .recent-post:hover strong {
    color: var(--stamp);
  }

  .section-more {
    display: inline-flex;
    width: max-content;
    margin-top: 22px;
    padding-bottom: 2px;
    color: var(--stamp);
    border-bottom: 1px solid currentColor;
    font-family: var(--font-sans);
    font-size: 12px;
    background-image: none !important;
  }

  :global([data-dynamic-moments]) {
    display: grid;
    align-content: start;
  }

  :global([data-dynamic-moments-list]) {
    display: grid;
    gap: 10px;
  }

  :global([data-dynamic-moments] .home-moment) {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr);
    align-items: start;
    gap: 18px;
    min-height: 58px;
    padding: 15px 0;
    color: var(--ink);
    border-bottom: 1px solid var(--border-soft);
    background-image: none !important;
    transition: border-color 150ms ease, color 150ms ease;
  }

  :global([data-dynamic-moments] .home-moment:first-child) {
    padding-top: 0;
  }

  :global([data-dynamic-moments] .home-moment time) {
    padding-top: 3px;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.5;
    white-space: nowrap;
  }

  :global([data-dynamic-moments] .home-moment span) {
    display: -webkit-box;
    overflow: hidden;
    color: var(--ink-soft);
    font-size: 16px;
    line-height: 1.72;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  :global([data-dynamic-moments] .home-moment:hover) {
    border-color: color-mix(in srgb, var(--stamp) 38%, var(--border-soft));
  }

  :global([data-dynamic-moments] .home-moment:hover span) {
    color: var(--ink);
  }

  @media (max-width: 760px) {
    .home-section {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
      padding: 42px 0;
    }

    .recent-post {
      grid-template-columns: 72px minmax(0, 1fr);
      gap: 14px;
    }

    .recent-post > span {
      display: none;
    }

    .recent-post strong {
      font-size: 16px;
    }

    :global([data-dynamic-moments] .home-moment) {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
      min-height: 0;
      padding: 16px 0;
    }

    :global([data-dynamic-moments] .home-moment time) {
      padding-top: 0;
    }

    :global([data-dynamic-moments] .home-moment span) {
      font-size: 15px;
      -webkit-line-clamp: 3;
    }
  }
</style>

<script>
  const root = document.querySelector("[data-dynamic-moments]");
  const feed = root?.querySelector("[data-dynamic-moments-list]");

  function formatMomentTime(datetime) {
    const date = new Date(datetime);
    const diff = date.valueOf() - Date.now();
    const absDiff = Math.abs(diff);
    const minute = 60 * 1000;
    const hour = 60 * minute;
    const day = 24 * hour;
    const week = 7 * day;

    if (absDiff < week) {
      const formatter = new Intl.RelativeTimeFormat("zh-CN", { numeric: "auto" });
      if (absDiff < hour) {
        return formatter.format(Math.round(diff / minute), "minute");
      }
      if (absDiff < day) {
        return formatter.format(Math.round(diff / hour), "hour");
      }
      return formatter.format(Math.round(diff / day), "day");
    }

    return new Intl.DateTimeFormat("zh-CN", {
      month: "short",
      day: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    }).format(date);
  }

  function renderMoment(post) {
    const link = document.createElement("a");
    link.className = "unset home-moment";
    link.href = `/moments/posts/${post.id}`;

    const time = document.createElement("time");
    time.dateTime = post.datetime;
    time.title = formatMomentTime(post.datetime);
    time.textContent = formatMomentTime(post.datetime);

    const excerpt = document.createElement("span");
    excerpt.textContent = post.text?.trim() || post.title?.trim() || "打开这条碎碎念";

    link.append(time, excerpt);
    return link;
  }

  async function refreshMoments() {
    if (!feed) {
      return;
    }

    const response = await fetch("/api/moments.json", { cache: "no-store" });
    if (!response.ok) {
      return;
    }

    const { posts } = await response.json();
    if (!Array.isArray(posts) || posts.length === 0) {
      return;
    }

    feed.replaceChildren(...posts.map(renderMoment));
  }

  refreshMoments().catch(() => {});
</script>
