---
import PageLayout from '../../../layouts/PageLayout.astro'
import PageMeta from '../../../components/PageMeta.astro'
import MomentsHero from '../../../components/MomentsHero.astro'
import TelegramList from '../../../components/TelegramList.astro'
import { SITE_TITLE } from '../../../config'
import { getChannelInfo } from '../../../lib/telegram'

const channel = await getChannelInfo(Astro, {
  before: Astro.params.cursor,
})

export const prerender = false
---

<PageLayout>
  <PageMeta title={`更早的碎碎念 | ${SITE_TITLE}`} slot="meta" />
  <Fragment slot="main">
    <MomentsHero title="更早的碎碎念" description="继续往时间的深处翻。" />
    <TelegramList channel={channel} before={true} after={true} />
  </Fragment>
</PageLayout>
