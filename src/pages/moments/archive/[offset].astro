---
import PageLayout from '../../../layouts/PageLayout.astro'
import PageMeta from '../../../components/PageMeta.astro'
import MomentsHero from '../../../components/MomentsHero.astro'
import LegacyMomentItem from '../../../components/LegacyMomentItem.astro'
import { SITE_TITLE } from '../../../config'
import { legacyData } from '../../../data/legacyMoments'

const pageSize = 20
const offset = Number(Astro.params.offset || 0)
const nextOffset = offset + pageSize

export const prerender = false
---

<PageLayout>
  <PageMeta title={`旧碎片 | ${SITE_TITLE}`} slot="meta" />
  <Fragment slot="main">
    <MomentsHero title="旧碎片" eyebrow="Archive" description="从旧数据迁过来的碎碎念，继续往前翻。" />
    <div class="moments-feed">
      {legacyData.slice(offset, nextOffset).map((post) => <LegacyMomentItem post={post} />)}
    </div>
    {
      nextOffset < legacyData.length ? (
        <nav class="moments-pagination" aria-label="旧碎片分页">
          <a class="unset moment-page-link" href={`/moments/archive/${nextOffset}`}>更早</a>
        </nav>
      ) : null
    }
  </Fragment>
</PageLayout>
