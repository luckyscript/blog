---
import { estimateReadingMinutes } from "../../lib/reading-time";
import { readOne, readAll } from "../../lib/markdoc/read";
import { blog } from "../../lib/markdoc/frontmatter.schema";
import Renderer from "../../components/Renderer.astro";
import BlogPostMeta from "../../components/BlogPostMeta.astro";
import ContentLayout from "../../layouts/ContentLayout.astro";
import { SITE_URL } from "../../config";
import { listCuratedLinks, routeCuratedLinks, registeredLinkForUrl } from '../../lib/server/links';
import { AppError } from '../../lib/server/errors';



const { slug } = Astro.params;
if (typeof slug !== "string") {
  throw Error(`slug should be string. Received: ${slug}`);
}

const { content, frontmatter } = await readOne({
  directory: "link",
  slug,
  frontmatterSchema: blog,
});
if (frontmatter.pageContent) return Astro.redirect('/link', 301);

const registeredLinks=await listCuratedLinks(true);
if (frontmatter.external && frontmatter.url) {
  const destination=registeredLinkForUrl(frontmatter.url,registeredLinks);
  if(!destination||destination.status!=='published')throw new AppError(404,'链接不存在或已下线');
  return Astro.redirect(`/link/to/${destination.id}`,302);
}
const linkedContent=routeCuratedLinks(content,registeredLinks);

const ogImageAbsoluteUrl =
  frontmatter.external !== true && frontmatter.ogImagePath
    ? new URL(frontmatter.ogImagePath, SITE_URL).toString()
    : undefined;
---

<ContentLayout readingMinutes={estimateReadingMinutes(content)} title={frontmatter.title} date={frontmatter.date}>
  <BlogPostMeta
    canonicalUrl={frontmatter.canonicalUrl}
    title={frontmatter.title}
    description={frontmatter.external ? undefined : frontmatter.description}
    publishDate={frontmatter.date.toISOString()}
    pagePath={`/link/${slug}`}
    ogImageAbsoluteUrl={ogImageAbsoluteUrl}
    slot="meta"
  />
  <Renderer content={linkedContent} slot="content" />
</ContentLayout>
