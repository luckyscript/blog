---
import { readAll } from '../lib/markdoc/read';
import { ppt } from '../lib/markdoc/frontmatter.schema';
import PageLayout from '../layouts/PageLayout.astro';
import PageMeta from '../components/PageMeta.astro';
import { SITE_TITLE } from '../config';
const posts=await readAll({directory:'ppt',frontmatterSchema:ppt});
const sortedPosts=posts.filter(post=>!post.frontmatter.draft).sort((a,b)=>new Date(b.frontmatter.date).getTime()-new Date(a.frontmatter.date).getTime());
function coverUrl(value:unknown){if(typeof value!=='string'||/\s/.test(value)||value.startsWith('//'))return '';try{const url=new URL(value,'https://local.invalid');return /^\/(?!\/)/.test(value)||url.protocol==='https:'?value:'';}catch{return '';}}
---
<PageLayout>
  <PageMeta title={`演示 | ${SITE_TITLE}`} slot="meta"/>
  <section slot="main" class="slides-page">
    <header class="slides-hero"><div><p class="slides-eyebrow"><span aria-hidden="true">演</span>讲述 · 分享</p><h1>演示</h1></div><p>把想法铺成几页幻灯片，<br/>留下一次讲述，也留下一条思路。</p></header>
    <div class="slides-count">{sortedPosts.length} 份演示文稿</div>
    <div class="slides-grid">
      {sortedPosts.map((post,index)=>{
        const frontmatter=post.frontmatter,description='description'in frontmatter?String(frontmatter.description||''):'',cover=coverUrl('ogImagePath'in frontmatter?frontmatter.ogImagePath:'');
        return <a class="unset slide-card" href={`/ppt/${post.slug}`} aria-label={`打开演示文稿：${frontmatter.title}`}>
          <div class:list={['slide-cover',index%2===1&&'slide-cover-alt']}>
            {cover?<img src={cover} alt="" loading="lazy" decoding="async"/>:<div class="slide-poster" aria-hidden="true"><span class="slide-poster-kicker">一席 · 演示手记</span><span class="slide-poster-title">{frontmatter.title}</span><span class="slide-poster-bottom">RAIN ON PIANO<span>{String(index+1).padStart(2,'0')}</span></span></div>}
            <span class="slide-play" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.3"><path d="m9 6 9 6-9 6z"/></svg></span>
          </div>
          <div class="slide-copy"><h2>{frontmatter.title}</h2>{description&&<p>{description}</p>}<footer><time datetime={frontmatter.date.toISOString()}>{frontmatter.date.toLocaleDateString('zh-CN',{year:'numeric',month:'long',day:'numeric'})}</time><span>{frontmatter.external?'站外演示':'在线演示'}</span></footer></div>
        </a>;
      })}
    </div>
    {sortedPosts.length===0&&<p class="slides-empty">新的演示正在准备中。</p>}
  </section>
</PageLayout>
<style>
  .slides-page{max-width:1000px;margin:0 auto;padding-bottom:30px}
  .slides-hero{display:flex;justify-content:space-between;align-items:end;gap:35px;padding-bottom:34px;border-bottom:1px solid var(--border)}
  .slides-eyebrow{display:flex;align-items:center;gap:12px;margin:0 0 18px;color:var(--ink-soft);font:13px var(--font-serif);letter-spacing:.12em}.slides-eyebrow>span{display:grid;place-items:center;width:26px;height:28px;border:1px solid var(--stamp);color:var(--stamp);font:18px var(--font-kai);transform:rotate(-4deg)}
  h1{margin:0;font:clamp(3rem,6.8vw,4.8rem)/1.1 var(--font-kai);color:var(--ink)}.slides-hero>p{margin:0 0 4px;color:var(--ink-soft);font:15px/1.9 var(--font-serif)}
  .slides-count{margin:25px 0 20px;color:var(--ink-muted);font:12px var(--font-serif)}
  .slides-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:26px}
  .slide-card{display:flex;flex-direction:column;min-width:0;border:1px solid var(--border-soft);border-radius:4px;overflow:hidden;background:var(--panel);background-image:none!important;transition:border-color .2s,transform .2s}
  .slide-card:hover{transform:translateY(-3px);border-color:var(--stamp)}.slide-card:focus-visible{outline:2px solid var(--stamp);outline-offset:5px}
  .slide-cover{position:relative;aspect-ratio:16/9;overflow:hidden;border-bottom:1px solid var(--border-soft);background:linear-gradient(120deg,color-mix(in srgb,var(--stamp) 9%,var(--paper)),var(--paper-deep));color:var(--ink)}
  .slide-cover-alt{background:linear-gradient(140deg,var(--paper-deep),color-mix(in srgb,var(--accent) 12%,var(--paper)))}.slide-cover>img{display:block;width:100%;height:100%;object-fit:cover}
  .slide-poster{position:absolute;inset:22px;display:flex;flex-direction:column;padding:17px 20px;border-block:1px solid color-mix(in srgb,var(--stamp) 28%,transparent)}
  .slide-poster::before{content:'';position:absolute;top:-1px;left:0;width:30px;border-top:2px solid var(--stamp)}
  .slide-poster-kicker{color:var(--ink-muted);font:10px var(--font-serif);letter-spacing:.16em}.slide-poster-title{display:block;max-width:85%;margin:auto 0;padding-block:12px;color:var(--ink);font:clamp(23px,3vw,33px)/1.45 var(--font-serif);text-wrap:balance;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.slide-poster-bottom{display:flex;justify-content:space-between;align-items:baseline;color:var(--ink-muted);font:8px var(--font-mono);letter-spacing:.15em}.slide-poster-bottom>span{font:17px var(--font-serif);letter-spacing:0}
  .slide-play{position:absolute;right:17px;bottom:17px;display:grid;place-items:center;width:34px;height:34px;border:1px solid var(--border);border-radius:50%;color:var(--stamp);background:var(--paper)}
  .slide-copy{flex:1;display:flex;flex-direction:column;padding:24px}.slide-copy h2{margin:0 0 12px;color:var(--ink);font:21px/1.5 var(--font-serif)}.slide-card:hover h2{color:var(--stamp)}.slide-copy p{margin:0 0 22px;color:var(--ink-soft);font:14px/1.8 var(--font-serif);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.slide-copy footer{display:flex;justify-content:space-between;gap:12px;margin-top:auto;padding-top:16px;border-top:1px solid var(--border-soft);color:var(--ink-muted);font:11px var(--font-serif)}
  .slides-empty{padding:55px 0;text-align:center;color:var(--ink-muted)}
  @media(max-width:680px){.slides-hero{flex-direction:column;align-items:start;gap:22px;padding-bottom:26px}.slides-hero>p{font-size:14px}.slides-grid{grid-template-columns:minmax(0,1fr);gap:20px}.slide-poster{inset:18px;padding:13px 14px}.slide-poster-title{font-size:25px}.slide-copy{padding:21px}.slide-copy h2{font-size:20px}}
  @media(prefers-reduced-motion:reduce){.slide-card{transition:none}}
</style>
