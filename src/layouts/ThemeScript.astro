<script is:inline>
  (function () {
    if (typeof window === "undefined") return;

    var validThemes = ["paper", "moon", "ink"];
    var savedTheme = localStorage.getItem("inkrain-theme");
    var legacyTheme = localStorage.getItem("theme");
    var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
    var theme = validThemes.indexOf(savedTheme) >= 0
      ? savedTheme
      : legacyTheme === "dark" || (!legacyTheme && prefersDark)
        ? "ink"
        : "paper";

    document.documentElement.dataset.theme = theme;
    document.documentElement.classList.toggle("dark", theme === "ink");

    var themeColor = document.querySelector('meta[name="theme-color"]');
    var themeColors = {
      paper: "#f4f0e6",
      moon: "#edf4f3",
      ink: "#20272b"
    };
    if (themeColor) themeColor.content = themeColors[theme];

    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function() {
        navigator.serviceWorker.register('/sw.js').catch(function() {});
      });
    }
  })();
</script>

<script type="speculationrules">
  {
    "prefetch": [
      {
        "source": "list",
        "urls": ["/blog", "/link", "/moments"]
      }
    ]
  }
</script>
