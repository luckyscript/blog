---
import { themeOrder, themes } from "../lib/themes";
---

<script is:inline define:vars={{ themeOrder, themes }}>
  (function () {
    if (typeof window === "undefined") return;

    var savedTheme = null;
    var legacyTheme = null;
    try {
      savedTheme = localStorage.getItem("inkrain-theme");
      legacyTheme = localStorage.getItem("theme");
    } catch {}
    var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
    var theme = themeOrder.indexOf(savedTheme) >= 0
      ? savedTheme
      : legacyTheme === "dark" || (!legacyTheme && prefersDark)
        ? "ink"
        : "paper";

    document.documentElement.dataset.theme = theme;
    document.documentElement.classList.toggle("dark", themes[theme].dark);

    var themeColor = document.querySelector('meta[name="theme-color"]');
    if (themeColor) themeColor.content = themes[theme].color;

    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function() {
        navigator.serviceWorker.register('/sw.js').catch(function() {});
      });
    }
  })();
</script>

<script type="speculationrules">
  {
    "prefetch": [
      {
        "source": "list",
        "urls": ["/blog", "/link", "/moments"]
      }
    ]
  }
</script>
