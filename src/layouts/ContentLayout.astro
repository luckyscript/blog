---
import Analytics from '../components/Analytics.astro';
/*
  This layout is used in pages that render markdoc content
  - pages/blog/[slug].astro
*/

// Import the global.css file here so that it is included on
import "../styles/global.css";
import "../styles/reading.css";
import '../styles/reading-surfaces.css';

import GoogleFont from "./GoogleFont.astro";
import FontAwesome from "./FontAwesome.astro";
import ThemeScript from "./ThemeScript.astro";
import Favicon from "./Favicon.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ReadingMaterial from '../components/ReadingMaterial.astro';
import CommentSection from '../components/CommentSection.astro';

export interface Props {
  title?: string;
  date: Date;
  update?: Date;
  category?: string;
  readingMinutes?: number;
}

const { title, date, update, category, readingMinutes } = Astro.props;
const displayTitle = title || "札记";
const formattedDate = new Date(date).toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "short",
  day: "numeric",
});

const updatedAt = update ? new Date(update) : undefined;
const outdays = updatedAt ? Math.floor((Date.now() - updatedAt.getTime()) / 86400000) : 0;
const isShowoutDays = outdays > 365;
const sections: Record<string, { href: string; name: string }> = {
  blog: { href: "/blog", name: "生活" },
  tech: { href: "/tech", name: "技术笔记" },
  sight: { href: "/sight", name: "摄影札记" },
  link: { href: "/link", name: "链接" },
  life: { href: "/life", name: "生活随笔" },
  card: { href: "/card", name: "札记" },
};
const section = sections[Astro.url.pathname.split("/")[1]] || { href: "/blog", name: "所有文章" };
---

<!DOCTYPE html>
<html class="theme-inkrain" data-theme="paper" lang="zh-CN">
  <head>
    <!-- Global Metadata -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content="Blogster" />
    {Astro.url.protocol === "https:" && <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests" />}
    <Favicon />
    <slot name="meta" />
    <GoogleFont />
    <ThemeScript />
    <script is:inline>
      try { var material=localStorage.getItem('inkrain-reading-material');document.documentElement.dataset.readingMaterial=['paper','bamboo','bronze','bone'].includes(material)?material:'paper'; } catch { document.documentElement.dataset.readingMaterial='paper'; }
    </script>
    <FontAwesome />
  </head>

  <body class="inkrain-body">
    <Header />
    <div class="inkrain-workspace reading-workspace">
      <main id="main" class="inkrain-main reading-main">
        <ReadingMaterial />
        <article class="reading-article" aria-labelledby="reading-title">
          <header class="reading-header">
            <nav class="reading-breadcrumbs" aria-label="文章位置">
              <a class="unset" href={section.href}>← {section.name}</a>
              {category && category !== section.name && (
                <>
                  <span aria-hidden="true">/</span>
                  <a class="unset reading-category" href={`/category/${encodeURIComponent(category)}`}>{category}</a>
                </>
              )}
            </nav>
            <h1 id="reading-title" class="reading-title">{displayTitle}</h1>
            <div class="reading-byline">
              <span class="reading-author-seal" aria-hidden="true">雨</span>
              <div>
                <span class="reading-author-name">墨雨</span>
                <div class="reading-details">
                  <time datetime={new Date(date).toISOString()}>{formattedDate}</time>
                  {readingMinutes && <><span aria-hidden="true">·</span><span>约 {readingMinutes} 分钟</span></>}
                </div>
              </div>
            </div>
          </header>
          {isShowoutDays && (
            <aside class="reading-notice">
              <span>旧文重读</span>
              最后更新于 {updatedAt!.toLocaleDateString("zh-CN")}，部分信息可能已有变化。
            </aside>
          )}
          <div class="reading-content prose max-w-none">
            <slot name="content" />
          </div>
          <div class="reading-endmark" aria-hidden="true"><span>雨</span></div>
          <slot name="frontmatter" />
          <nav class="reading-navigation" aria-label="文章导航">
            <a class="unset" href={section.href}>← 返回{section.name}</a>
            <a class="unset" href="#main">回到篇首 ↑</a>
          </nav>
          <CommentSection />
        </article>
      </main>
      <Footer />
    </div>
    <Analytics />
  </body>
</html>
