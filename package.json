{
  "name": "luckyscript.me",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "check:build-secrets": "node --env-file-if-exists=.env scripts/check-build-secrets.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "clean": "rm -rf dist",
    "db:setup": "node --env-file-if-exists=.env --import tsx scripts/db-setup.ts",
    "moments:sync": "node --env-file-if-exists=.env --import tsx scripts/sync-moments.ts",
    "moments:service": "node --env-file-if-exists=.env --import tsx scripts/sync-moments.ts --service",
    "moments:health": "node --env-file-if-exists=.env --import tsx scripts/sync-moments.ts --healthcheck",
    "moments:import-weibo": "node --env-file-if-exists=.env --import tsx scripts/import-weibo-archive.ts",
    "moments:auth-weibo": "node --env-file-if-exists=.env --import tsx scripts/weibo-auth.ts",
    "db:import": "node --env-file-if-exists=.env --import tsx scripts/import-content.ts",
    "db:backup": "node --env-file-if-exists=.env --import tsx scripts/backup.ts",
    "db:backup:service": "node --env-file-if-exists=.env --import tsx scripts/backup-service.ts",
    "db:backup:once": "node --env-file-if-exists=.env --import tsx scripts/backup-service.ts --once",
    "db:backup:health": "node --env-file-if-exists=.env --import tsx scripts/backup-service.ts --healthcheck",
    "db:backup:check": "node --env-file-if-exists=.env --import tsx scripts/backup-service.ts --verify",
    "db:verify-backup": "node --env-file-if-exists=.env --import tsx scripts/verify-backup.ts",
    "serve": "node --env-file-if-exists=.env dist/server/entry.mjs",
    "typecheck": "tsc -p tsconfig.admin.json",
    "test": "node --env-file-if-exists=.env --import tsx --test tests/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env --import tsx scripts/test-integration.ts",
    "test:site": "node --env-file-if-exists=.env --import tsx --test tests/site-regression.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.10",
    "@astrojs/markdoc": "^0.15.7",
    "@astrojs/node": "^9.5.0",
    "@astrojs/prism": "^3.3.0",
    "@astrojs/react": "^4.4.0",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/tailwind": "^6.0.2",
    "@markdoc/markdoc": "^0.2.1",
    "@tailwindcss/typography": "^0.5.9",
    "@types/react": "^18.0.34",
    "@types/react-dom": "^18.0.11",
    "ali-oss": "^6.23.0",
    "astro": "^5.14.1",
    "astro-markdoc-renderer": "0.0.1-alpha.1",
    "cheerio": "^1.1.2",
    "dayjs": "^1.11.11",
    "drizzle-orm": "^0.45.4",
    "flourite": "^1.3.0",
    "globby": "^13.1.3",
    "gray-matter": "^4.0.3",
    "lodash.groupby": "^4.6.0",
    "lru-cache": "^11.2.2",
    "mysql2": "^3.24.6",
    "ofetch": "^1.4.1",
    "prismjs-components-importer": "^0.2.0",
    "proper-lockfile": "^4.1.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reveal.js": "^4.4.0",
    "sanitize-html": "^2.18.1",
    "slugify": "^1.6.5",
    "std-env": "^3.10.0",
    "tailwindcss": "^3.2.4",
    "undici": "7.16.0",
    "zod": "^3.20.2"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.4",
    "@types/node": "^22.20.5",
    "@types/proper-lockfile": "^4.1.4",
    "@types/reveal.js": "^4.4.2",
    "@types/sanitize-html": "^2.16.2",
    "prettier-plugin-astro": "^0.7.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "repository": "git@github.com:luckyscript/luckyscript.me.git"
}
