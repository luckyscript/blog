{
  "name": "jianshan-photography",
  "version": "4.1.1",
  "private": true,
  "description": "A multipage photography portfolio and chronological archive",
  "scripts": {
    "build": "node src/build.mjs",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "backup": "node --env-file-if-exists=.env server/backup.mjs",
    "restore": "node --env-file-if-exists=.env server/backup.mjs restore",
    "db:check": "node --env-file-if-exists=.env server/database-cli.mjs check",
    "db:init": "node --env-file-if-exists=.env server/database-cli.mjs init",
    "db:migrate": "node --env-file-if-exists=.env server/database-cli.mjs migrate",
    "r2:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.r2 server/r2-check.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1134.0",
    "exifr": "7.1.3",
    "heic-decode": "2.1.0",
    "mysql2": "3.24.4",
    "sharp": "0.35.4"
  },
  "engines": {
    "node": ">=22.20.0"
  }
}
