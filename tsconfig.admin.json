{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "astro/client"],
    "noEmit": true
  },
  "include": [
    "src/db/**/*.ts",
    "src/lib/server/**/*.ts",
    "src/lib/moments/**/*.ts",
    "src/lib/markdoc/render.ts",
    "src/middleware.ts",
    "src/components/admin/**/*.tsx",
    "src/pages/api/admin/**/*.ts",
    "src/pages/api/health.ts",
    "src/env.d.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
