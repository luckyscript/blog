[Unit]
Description=Rain Blog social moments synchronization
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=rain-blog-moments
Group=rain-blog-moments
SupplementaryGroups=rain-blog-code
WorkingDirectory=/opt/rain-blog/current
Environment=NODE_ENV=production
ExecStart=/opt/rain-blog/runtime/bin/node --env-file=/etc/rain-blog/moments.env --max-old-space-size=128 --import tsx scripts/sync-moments.ts --service
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
UMask=0077
StateDirectory=rain-blog-moments
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
MemoryMax=256M

[Install]
WantedBy=multi-user.target
