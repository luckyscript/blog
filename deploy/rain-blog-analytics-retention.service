[Unit]
Description=Prune anonymous blog analytics older than 180 days
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=rain-blog
Group=rain-blog
SupplementaryGroups=rain-blog-code
WorkingDirectory=/opt/rain-blog/current
ExecStart=/opt/rain-blog/runtime/bin/node --env-file=/etc/rain-blog/web.env --import tsx scripts/prune-analytics.ts
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=128M
