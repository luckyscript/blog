# 复制为 .env，填写自己的密码。不要将 .env 提交到 Git。
CONTENT_SOURCE=mysql
DATABASE_URL=mysql://blog:replace-with-password@127.0.0.1:13306/blog
MYSQL_PORT=13306
MYSQL_PASSWORD=replace-with-password
MYSQL_ROOT_PASSWORD=replace-with-another-password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-password

# 后台登录必须通过 Cloudflare Turnstile。Secret Key 仅在服务端使用。
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 留空时使用 SITE_URL 的主机名；多个域名以逗号分隔，不含协议和端口。
TURNSTILE_HOSTNAMES=

# 公开图片仓库，令牌仅由服务端读取，限定该仓库 Contents: Read and write 权限。
GITHUB_MEDIA_REPO=luckyscript/image
GITHUB_MEDIA_BRANCH=master
GITHUB_MEDIA_TOKEN=
GITHUB_MEDIA_PREFIX=uploads
SITE_URL=http://localhost:3000

# 碎碎念：独立服务每 5 分钟抓取，前台只读 MySQL。
MOMENTS_TELEGRAM_CHANNEL=jsjhlkblog
MOMENTS_SYNC_INTERVAL_SECONDS=300
# ECS 无法直连 Telegram 时，使用服务器可达的 HTTP/HTTPS 正向代理。
MOMENTS_HTTP_PROXY=
# 可选：由自己维护、提供兼容 /s/<频道> HTML 的 HTTPS 中转站点。
MOMENTS_TELEGRAM_ORIGIN=https://t.me
# 微博两个账号各自完成官方 OAuth。凭据目录必须私有，不放入公开文件或 Git。
MOMENTS_WEIBO_UIDS=5351049607,1562002727
MOMENTS_WEIBO_INTERVAL_SECONDS=3600
MOMENTS_WEIBO_CREDENTIAL_DIRECTORY=.local/weibo

# 独立数据库备份服务。时间固定按 Asia/Shanghai 计算。
# 可为备份单独配置只读数据库账号；留空时使用 DATABASE_URL。
BACKUP_DATABASE_URL=
BACKUP_DIRECTORY=.local/backups/service
BACKUP_TIME=03:00
BACKUP_RETENTION_DAYS=30
BACKUP_TIMEOUT_SECONDS=900

# 可选：使用私有 OSS Bucket 保存第二份备份。填写时以下四项必须完整。
BACKUP_OSS_BUCKET=
# Region 示例：oss-cn-hangzhou
BACKUP_OSS_REGION=
BACKUP_OSS_PREFIX=blog-database
BACKUP_OSS_ACCESS_KEY_ID=
BACKUP_OSS_ACCESS_KEY_SECRET=
BACKUP_OSS_STS_TOKEN=
