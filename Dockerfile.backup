FROM node:22-bookworm-slim
WORKDIR /opt/blog
COPY package.json package-lock.json ./
RUN npm ci --include=dev --no-audit --no-fund && npm cache clean --force
COPY src/db/backup.ts ./src/db/backup.ts
COPY src/lib/server/env.ts ./src/lib/server/env.ts
COPY src/lib/backup ./src/lib/backup
COPY scripts/backup-service.ts ./scripts/backup-service.ts
RUN mkdir -p /var/lib/blog-backups && chown node:node /var/lib/blog-backups
USER node
ENV BACKUP_DIRECTORY=/var/lib/blog-backups
CMD ["node", "--import", "tsx", "scripts/backup-service.ts"]
